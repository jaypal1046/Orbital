<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Expandable Floating Chat Card -->
    <LinearLayout
        android:id="@+id/chatPanel"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_chat_panel"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone"
        android:elevation="12dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="8dp">

            <View
                android:id="@+id/chatStatusDot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_avatar_circle" />

            <TextView
                android:id="@+id/chatCompanionName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Orbital AI Companion"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/chatCloseButton"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close"
                android:contentDescription="Close" />
        </LinearLayout>

        <!-- Response / Messages Scroll Container -->
        <ScrollView
            android:id="@+id/chatScrollView"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:fadeScrollbars="false"
            android:padding="4dp">

            <TextView
                android:id="@+id/chatResponseText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="3dp"
                android:text="Hi! How can I help you today? Type below or long-press the avatar to speak."
                android:textColor="#E2E8F0"
                android:textSize="13sp" />
        </ScrollView>

        <!-- Input Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/chatInputEditText"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input_field"
                android:hint="Ask or command anything..."
                android:textColorHint="#7C74A8"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:imeOptions="actionSend"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="3" />

            <ImageView
                android:id="@+id/chatMicButton"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="6dp"
                android:src="@drawable/ic_mic"
                android:contentDescription="Whisper Voice" />

            <ImageView
                android:id="@+id/chatSendButton"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="4dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="6dp"
                android:src="@drawable/ic_send"
                android:contentDescription="Send" />
        </LinearLayout>
    </LinearLayout>

    <!-- Floating Mascot Avatar Container (Sleek & balanced 52dp) -->
    <FrameLayout
        android:id="@+id/bubbleAvatarContainer"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:gravity="center"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:background="@android:color/transparent"
        android:elevation="8dp">

        <View
            android:id="@+id/voiceStatusIndicator"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent" />

        <!-- Mascot Character Image (Crystal Clear HD Mascot) -->
        <ImageView
            android:id="@+id/characterImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:src="@drawable/aether_idle"
            android:visibility="visible"
            android:contentDescription="@string/app_name" />

        <!-- Status Dot in corner -->
        <View
            android:id="@+id/connectionIndicator"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="1dp"
            android:layout_marginBottom="1dp"
            android:background="@drawable/bg_status_dot"
            android:elevation="10dp" />

        <!-- Hidden compat textview for status receiver -->
        <TextView
            android:id="@+id/connectionStatusText"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>